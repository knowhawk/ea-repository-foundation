            <property key="TOGAF Artifact" value="Stakeholder Catalog"/>
            <property key="ADM Phase" value="Phase A - Architecture Vision"/>
            <property key="Artifact Type" value="Catalog"/>
            <property key="ArchiMate Viewpoint" value="Stakeholder"/>
            <property key="Reference" value="TOGAF® Standard, 10th Edition - Architecture Content - https://pubs.opengroup.org/togaf-standard/architecture-content/chap03.html#tag_03_06_02_01"/>
          </element>
        </folder>
        <folder name="Phase B - Business Architecture" id="id-975709f493f94424927e2d248674650d">
          <documentation>Guide views for the artifacts (catalogs, matrices, tables and diagrams) of Phase B - Business Architecture.</documentation>
